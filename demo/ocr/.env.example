CONTENTUNDERSTANDING_ENDPOINT=https://<your-resource>.services.ai.azure.com/
CONTENTUNDERSTANDING_KEY=
# Existing CU analyzer used for field extraction. prebuilt-layout is OCR/layout diagnostics only.
CU_ANALYZER_ID=
CU_API_VERSION=2025-11-01
# Relative paths below are resolved from this .env file, not from the kernel.
OCR_INPUT_FILE=input/statement.pdf
OCR_TARGET_DPI=300
OCR_FOCUS_PAGE=1
OCR_MINUS_BOX=
OCR_KEYWORD=property tax
OCR_EXPECTED_AMOUNTS=input/expected_amounts.csv
OCR_REDACT_BOXES=input/redact_boxes.json
