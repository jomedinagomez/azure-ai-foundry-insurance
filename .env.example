# Repo-wide local config. Copy to .env and fill in. Do not commit real values.
# Used by the workshop API (apps/workshop/api/standalone_api.py) and by the
# demo/sov, demo/sec, demo/classifier, and demo/labeled-analyzer notebooks. Frontend env lives in
# apps/workshop/web/.env (see apps/workshop/web/.env.example).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Azure AI Foundry / Cognitive Services endpoint hosting
# Content Understanding (and the chat-completion deployments below).
# Example: https://my-foundry.services.ai.azure.com/
# Aliases also accepted (first non-empty wins, in this order):
#   APP_CONTENT_UNDERSTANDING_ENDPOINT → CONTENTUNDERSTANDING_ENDPOINT → FOUNDRY_ENDPOINT
# ─────────────────────────────────────────────────────────────────────────────
APP_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-foundry-or-cognitive-services-endpoint>/

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — auth mode.
#   dev  → DefaultAzureCredential (uses `az login`)
#   prod → ManagedIdentityCredential (for Azure-hosted runs)
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=dev
# Optional local-only DefaultAzureCredential source selection (recent azure-identity).
# Use after `az login` if notebook credentials otherwise select a different identity.
# Remove this selection for deployed managed-identity workloads.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# ─────────────────────────────────────────────────────────────────────────────
# Model deployments (names in your Foundry resource, not model family IDs).
# configure_cu_defaults.py maps model names used by analyzer templates to
# these deployments. SEC also reads APP_CU_COMPLETION_DEPLOYMENT directly.
# Whichever names you set must exist as deployments in your Foundry project.
# Leave unset to skip injection.
# ─────────────────────────────────────────────────────────────────────────────

# Chat-completion deployment used by SEC.
# Resolution: APP_CU_COMPLETION_DEPLOYMENT -> GPT41_MINI_MODEL_DEPLOYMENT -> GPT41_MODEL_DEPLOYMENT
APP_CU_COMPLETION_DEPLOYMENT=gpt-4.1-mini

# Embedding deployment used by SEC and the labeled analyzer.
# Resolution order: EMBEDDING_MODEL_DEPLOYMENT → APP_CU_EMBEDDING_DEPLOYMENT
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-large

# Model deployment names consumed by defaults and service resolution.
GPT52_MODEL_DEPLOYMENT=gpt-5.2
GPT41_MODEL_DEPLOYMENT=gpt-4.1
GPT41_MINI_MODEL_DEPLOYMENT=gpt-4.1-mini

# Host-owned Storage account used only for temporary learned-analyzer staging.
# Customers using the labeling UI do not receive storage credentials. With the
# 2026-06-01-preview training flow, each per-project container is deleted after
# the analyzer build completes.
LABELED_ANALYZER_STORAGE_ACCOUNT=
LABELED_ANALYZER_STORAGE_CONTAINER=cu-labeled-claims
LABELED_ANALYZER_STORAGE_PREFIX=training/v1/
# Live paid evaluation is disabled by default and restricted to loopback clients.
LABELED_ANALYZER_ENABLE_LIVE=false
# LABELED_ANALYZER_LIVE_COOLDOWN_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────────
# Optional — Document Intelligence vs Content Understanding comparison
# Uses FOUNDRY_RESOURCE_NAME to derive these endpoints when they are omitted.
# Live service calls remain disabled until explicitly enabled.
# ─────────────────────────────────────────────────────────────────────────────
# DOCUMENTINTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# LANGUAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
EXTRACTION_COMPARISON_RUN_AZURE=false
EXTRACTION_COMPARISON_RUN_PII=false
EXTRACTION_COMPARISON_CONFIGURE_DEFAULTS=true
EXTRACTION_COMPARISON_ANALYZER_ID=claimExtractionComparisonV1
EXTRACTION_COMPARISON_LANGUAGE_TIER=S
EXTRACTION_COMPARISON_CORPUS_DOCUMENTS=1000000
# Set true only if the CU usage contract reports cached input as a subset.
CU_INPUT_TOKENS_INCLUDE_CACHED=false
# ARM region name used for live Azure Retail Prices API lookup.
AZURE_PRICING_REGION=eastus

# ─────────────────────────────────────────────────────────────────────────────
# Optional — server & timeouts
# ─────────────────────────────────────────────────────────────────────────────
# Port for the workshop API (standalone_api.py). Default: 8000.
# PORT=8000
# Per-call timeout (seconds) for /analyzer-compare. Default: 300.
# ANALYZER_COMPARE_TIMEOUT_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# Optional — override demo asset roots (default: <repo>/demo/<name>)
# ─────────────────────────────────────────────────────────────────────────────
# SOV_DEMO_ROOT=
# SEC_DEMO_ROOT=
# LABELED_ANALYZER_DEMO_ROOT=

# Standalone CU + AI Search notebooks (no workshop server required).
# Native documentSearch/imageSearch routing; no resource defaults are patched.
CU_API_VERSION=2025-11-01
# Paths are relative to the repository root unless absolute.
CLAIM_FOLDER=data\claims\claim-001
# Choose a new account-specific output root when switching Foundry accounts.
CLAIMS_OUTPUT_ROOT=output\claims
# Use a new index name for the claims-evidence schema; do not overwrite the old demo index.
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=claims-evidence-v1
# All three RAG notebooks use Microsoft Entra ID via DefaultAzureCredential.
# Embeddings use OpenAI v1 on the same account as APP_CONTENT_UNDERSTANDING_ENDPOINT.
# Optional verified same-account endpoint; otherwise derive it from the CU hostname.
# Both .services.ai.azure.com and .cognitiveservices.azure.com CU hosts are supported.
# AZURE_OPENAI_ENDPOINT=https://<same-account>.openai.azure.com/
# Optional project endpoint for connection lookup; not the CU or Search service URL.
# AZURE_AI_PROJECT_ENDPOINT=https://<same-account>.services.ai.azure.com/api/projects/<project>
# No dated OpenAI API version or API keys are needed.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Dimensions must match the embedding deployment and index.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# Local read-only claims agent. Registration is external telemetry metadata, not hosted compute.
CLAIMS_AGENT_NAME=claims-local-assistant
CLAIMS_AGENT_MODEL_DEPLOYMENT=gpt-5.2
# Must be a loopback HTTP origin. Agent consumes the actual local structured-data API.
CLAIMS_STRUCTURED_API_BASE_URL=http://127.0.0.1:8000
# AZURE_AI_PROJECT_ENDPOINT (above), AZURE_SUBSCRIPTION_ID and AZURE_RESOURCE_GROUP
# identify the selected project and its existing AppInsights connection.
# Register agent explicitly in Claims Explorer; no keys or telemetry destination secrets are printed.
